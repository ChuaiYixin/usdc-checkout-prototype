# Copy to .env (or run `npm run setup`, which generates the secrets for you).
# TESTNET ONLY. Never put a mainnet seed phrase or a funded mainnet key here.

# --- Secrets (generated by `npm run setup`) ---
# HD seed for the platform. Index 0 = gas sponsor wallet, index 1.. = one deposit address per payment request (PRD R7).
PLATFORM_MNEMONIC=
# Optional: a throwaway buyer key, used by `npm run pay:test` to send a real testnet payment without a browser wallet.
TEST_BUYER_PRIVATE_KEY=
# HMAC secret used to sign webhooks to the (mock) merchant endpoint.
WEBHOOK_SECRET=

# --- Chain ---
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- App ---
APP_URL=http://localhost:3000
DATABASE_URL=file:data/app.db

# Circle's faucet gives 20 USDC per address every 2 hours, so by default the on-chain amount is the
# order amount divided by 100 (a 120 USD order asks the wallet for 1.20 test USDC). Set to 1 to pay 1:1.
NEXT_PUBLIC_TESTNET_AMOUNT_DIVISOR=100

# Dev-only: adds a 'Test wallet (dev)' button on the payment page that signs with TEST_BUYER_PRIVATE_KEY
# (lets you exercise the wallet flow without MetaMask). Never enabled in production builds.
NEXT_PUBLIC_DEV_TEST_WALLET=0
